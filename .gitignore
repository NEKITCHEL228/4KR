# Зависимости (скачиваются заново командой npm install)
node_modules/

# Файлы с секретными переменными (пароли от БД)
.env
*.env

# Логи ошибок npm (появляются, если сервер крашится)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Системные файлы (создаются Windows и macOS автоматически)
.DS_Store
Thumbs.db

# Папки редакторов кода (настройки конкретного разработчика)
.vscode/
.idea/